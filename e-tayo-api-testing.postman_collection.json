  "item": [
    {
      "name": "/api/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Signed JWT token & user role claims returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"accessToken\");",
              "    pm.expect(jsonData.accessToken).to.be.a(\"string\");",
              "    pm.expect(jsonData).to.have.property(\"role\");",
              "    pm.expect(jsonData.role).to.eql(\"ROLE_ADMIN\");",
              "    pm.collectionVariables.set(\"jwtToken\", jsonData.accessToken);",
              "    if (pm.environment) { pm.environment.set(\"jwtToken\", jsonData.accessToken); }",
              "});",
              "",
              "pm.test(\"Operational latency is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@etayo.gov.ph\",\n  \"password\": \"Admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Executed returning HTTP 200 OK with signed JWT token, user role claims, and HTTP-only cookie configuration."
      },
      "response": []
    },
    {
      "name": "/api/auth/send-otp",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Secure 6-digit OTP generated & automated dispatch\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"object\");",
              "    pm.expect(jsonData.message || jsonData.debugOtp || \"OTP sent\").to.include(\"OTP\");",
              "});",
              "",
              "pm.test(\"Operational latency is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"applicant.test{{$timestamp}}@gmail.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/send-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "send-otp"
          ]
        },
        "description": "Executed returning HTTP 200 OK with secure 6-digit OTP generation and automated SMTP email dispatch."
      },
      "response": []
