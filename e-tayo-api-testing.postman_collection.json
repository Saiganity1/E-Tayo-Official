    "name": "e-Tayo - API Unit Testing",
    "description": "API Unit Testing Collection for e-Tayo Sto. Tomas Municipal e-Governance and Permitting Platform. Supports single-click Collection Runner execution without requiring an environment setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://e-tayo-official-by0b.onrender.com",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
