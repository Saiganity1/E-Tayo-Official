    {
      "name": "/api/permits",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created or 200 OK\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test(\"Generated tracking ID and document payload persistence\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData.id).to.include(\"LC-\");",
              "    pm.collectionVariables.set(\"permitId\", jsonData.id || \"LC-2025-0001\");",
              "    if (pm.environment) { pm.environment.set(\"permitId\", jsonData.id || \"LC-2025-0001\"); }",
              "});",
              "",
              "pm.test(\"Operational latency is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
